# Addresses of Central and Kafka for the lab PCs.
# Copy this file to lab.env (not uploaded to the repository) and fill in the values:
#
#   cp lab.env.example lab.env
#
# With Railway, they are the TCP Proxy addresses of wm-central and kafka.

# WM_WS_M connects here (socket server of WM_Central)
CENTRAL_HOST=
CENTRAL_PORT=

# WM_WS_E and WM_FO connect here, as host:port
KAFKA_BOOTSTRAP=
