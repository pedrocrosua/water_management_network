# Direcciones de WM_Central y Kafka para los PC del laboratorio.
# Son las del TCP Proxy de wm-central y de kafka en Railway: si cambian allí,
# hay que cambiarlas también aquí.

# WM_WS_M se conecta aquí (servidor de sockets de WM_Central)
CENTRAL_HOST=iriguchi.proxy.rlwy.net
CENTRAL_PORT=26572

# WM_WS_E y WM_FO se conectan aquí, como host:puerto
KAFKA_BOOTSTRAP=altaria.proxy.rlwy.net:55723
